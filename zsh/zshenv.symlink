# preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
    export EDITOR='vim'
elif [[ -n ${NVIM_LISTEN_ADDRESS+x} ]]; then
    export EDITOR='nvr'
else
    export EDITOR='nvim'
fi

[[ $TMUX = "" ]] && export TERM="xterm-256color"

export LANG=en_US.UTF-8
export LESS='-iR'

# set defaults for fzf
export FZF_DEFAULT_COMMAND='fd --hidden --strip-cwd-prefix'

# set location for cask to install apps
export HOMEBREW_CASK_OPTS="--appdir=/Applications"
# set manual update
export HOMEBREW_NO_AUTO_UPDATE=1

# Disable Pi's own startup version check; keep model catalog refreshes enabled.
export PI_SKIP_VERSION_CHECK=1

# set location and version for Java JDK (hardcoded for performance)
# Homebrew openjdk@25 is keg-only; the opt symlink survives patch upgrades.
# Switch per shell with java11/java17/java25 (defined in ~/.localrc).
export JAVA_HOME="/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home"

