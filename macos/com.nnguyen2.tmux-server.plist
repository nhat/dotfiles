<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nnguyen2.tmux-server</string>
	<!-- Start the tmux server and session "main" at GUI login so ssh clients
	     that only run `tmux attach` find a session, in a server
	     that has keychain access. Needs `set -s exit-empty off` in tmux.conf. -->
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/tmux</string>
		<string>new-session</string>
		<string>-d</string>
		<string>-s</string>
		<string>main</string>
		<string>-c</string>
		<string>/Users/nnguyen2/Downloads</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/nnguyen2/Downloads</string>
	<key>RunAtLoad</key>
	<true/>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
</dict>
</plist>
